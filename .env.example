# Copy to .env and change the password before use.
POSTGRES_USER=cipher
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cipher_workbench
DATABASE_URL=postgresql+asyncpg://cipher:change-me@db:5432/cipher_workbench
# Host port for the db service (localhost only); 5433 avoids a local Postgres on 5432.
DB_HOST_PORT=5433
# Host port for the app service; the container itself listens on 8000.
APP_HOST_PORT=8080
# GET /api/history has no authentication. Enable it for local development only;
# leave it false (or unset) on any shared or public deployment.
HISTORY_API_ENABLED=true
# History rows older than this many days are deleted (1 to 3650).
HISTORY_RETENTION_DAYS=30
