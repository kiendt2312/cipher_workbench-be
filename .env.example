# SQLite history lives only on the backend's local persistent /data volume.
# Four slashes after sqlite+aiosqlite: indicate an absolute path.
DATABASE_URL=sqlite+aiosqlite:////data/cipher-history.sqlite3
# LEGACY_DATABASE_URL is transfer-only and intentionally absent from app runtime config.
# Host port for the app service; the container itself listens on 8000.
APP_HOST_PORT=8080
# GET /api/history has no authentication. Enable it for local development only;
# leave it false (or unset) on any shared or public deployment.
HISTORY_API_ENABLED=true
# History rows older than this many days are deleted (1 to 3650).
HISTORY_RETENTION_DAYS=30
# Exact FE origins allowed to call the API cross-origin, comma separated.
# Leave empty when the FE proxies /api (no CORS headers are sent).
CORS_ALLOW_ORIGINS=
